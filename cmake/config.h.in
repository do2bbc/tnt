#ifndef TNT_CONFIG_H
#define TNT_CONFIG_H

#ifndef _GNU_SOURCE
#define _GNU_SOURCE 1
#endif
#ifndef _NETBSD_SOURCE
#define _NETBSD_SOURCE 1
#endif
#ifndef __EXTENSIONS__
#define __EXTENSIONS__ 1
#endif
#ifndef _POSIX_PTHREAD_SEMANTICS
#define _POSIX_PTHREAD_SEMANTICS 1
#endif

#define PACKAGE "tnt"
#define PACKAGE_NAME "tnt"
#define PACKAGE_VERSION "@TNT_VERSION@"
#define PACKAGE_STRING "tnt @TNT_VERSION@"
#define VERSION "@TNT_VERSION@"

#cmakedefine BCAST 1
#cmakedefine USE_IFACE 1
#cmakedefine TNT_SERIAL 1
#cmakedefine TNT_SOUND 1
#cmakedefine ENABLE_NLS 1
#cmakedefine GEN_NEW_USER 1
#cmakedefine USE_HIBAUD 1
#cmakedefine USE_AX25K 1
#cmakedefine USE_AX25K2 1
#cmakedefine SPECIAL 1
#cmakedefine PWD_NOT_EMPTY 1

#define DEF_AUTO_NEWLINE @DEF_AUTO_NEWLINE@
#define DEF_SUPP_HICNTL @DEF_SUPP_HICNTL@
#define DEF_TERMCAP @DEF_TERMCAP@
#define DEF_COLOR @DEF_COLOR@
#define DIR_STRING "@DIR_STRING@"
#define DIRL_STRING "@DIRL_STRING@"
#define DIRRUN_STRING "@DIRRUN_STRING@"
#define FREE_STRING "@FREE_STRING@"
#define DEFAULT_EDITOR "@DEFAULT_EDITOR@"
#define TNT_INIT_PATH "@tnt_conf_dir@"
#define TNT_RUN_PATH "@tnt_bin_dir@"
#define TNT_MAIN_PATH "@tnt_log_dir@"

#cmakedefine HAVE_TERMCAP_H 1
#cmakedefine HAVE_LANGINFO_H 1
#cmakedefine HAVE_SYS_SELECT_H 1
#cmakedefine HAVE_SYS_WAIT_H 1
#cmakedefine HAVE_TERMIO_H 1
#cmakedefine HAVE_MEMMOVE 1
#cmakedefine HAVE_INDEX 1
#cmakedefine HAVE_SOCKET 1
#cmakedefine HAVE_SOCKLEN_T 1
#cmakedefine HAVE_USLEEP 1
#cmakedefine HAVE_SRANDOM 1
#cmakedefine HAVE_CRTSCTS 1
#cmakedefine HAVE_UT_HOST 1
#cmakedefine HAVE_UT_EXIT 1
#cmakedefine HAVE_BIND_TEXTDOMAIN_CODESET 1
#cmakedefine HAVE_NETAX25_AX25_H 1
#cmakedefine HAVE_NET_AX25_H 1
#cmakedefine HAVE_NETROM_NETROM_H 1
#cmakedefine HAVE_NETROSE_ROSE_H 1
#cmakedefine HAVE_NETAX25_PROCUTILS_H 1

#endif
