set(manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${manifest}")
  message(FATAL_ERROR "No install manifest found; install from this build directory first")
endif()
file(STRINGS "${manifest}" files)
foreach(path IN LISTS files)
  set(installed "$ENV{DESTDIR}${path}")
  if(IS_SYMLINK "${installed}" OR
      (EXISTS "${installed}" AND NOT IS_DIRECTORY "${installed}"))
    message(STATUS "Removing ${installed}")
    file(REMOVE "${installed}")
    if(EXISTS "${installed}" OR IS_SYMLINK "${installed}")
      message(FATAL_ERROR "Cannot remove ${installed}")
    endif()
  endif()
endforeach()
