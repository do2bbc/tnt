set(stage "${BINARY_DIR}/install-test")
if(FLAT AND (NOT INCLUDEDIR STREQUAL "${PREFIX}/tnt/include" OR
             NOT INFODIR STREQUAL "${PREFIX}/tnt/documentation" OR
             NOT LOCALEDIR STREQUAL "${PREFIX}/tnt/locale"))
  message(FATAL_ERROR "Flat installation no longer matches the legacy layout")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DESTDIR=${stage}"
  "${CMAKE_COMMAND}" --install "${BINARY_DIR}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Staged installation failed")
endif()
set(installed_paths
    "${BINDIR}/tnt" "${BINDIR}/tntc" "${SBINDIR}/tnt_setup.de"
    "${BINDIR_HELP}/help" "${BINDIR_HELP}/logcall" "${BINDIR_HELP}/tnt-info"
    "${BINDIR_HELP}/.help" "${INCLUDEDIR}/tntrun.h"
    "${CONFDIR}/tnt.ini.ex" "${CONFDIR}/tntc.ini.ex"
    "${DOCDIR}/tnt.hlp.de" "${DOCDIR}/tntdoc.html"
    "${INFODIR}/tntdoc.info" "${SOUNDDIR}/play"
    "${WORKDIR}/bcast/save")
foreach(path IN LISTS installed_paths)
  if(NOT EXISTS "${stage}${path}")
    message(FATAL_ERROR "Missing installed path: ${path}")
  endif()
endforeach()
set(links "${BINDIR_HELP}/info")
if(NOT "${WORKDIR}/bin" STREQUAL "${BINDIR_HELP}")
  list(APPEND links "${WORKDIR}/bin")
endif()
foreach(path IN LISTS links)
  if(NOT IS_SYMLINK "${stage}${path}")
    message(FATAL_ERROR "Missing installed symlink: ${path}")
  endif()
endforeach()
if(NLS)
  foreach(lang de fr)
    if(NOT EXISTS "${stage}${LOCALEDIR}/${lang}/LC_MESSAGES/tnt.mo")
      message(FATAL_ERROR "Missing ${lang} translation")
    endif()
  endforeach()
elseif(EXISTS "${stage}${LOCALEDIR}/de/LC_MESSAGES/tnt.mo")
  message(FATAL_ERROR "Translations installed with TNT_NLS=OFF")
endif()
file(READ "${stage}${CONFDIR}/tnt.ini.ex" example)
if(example MATCHES "@[A-Za-z_]+@")
  message(FATAL_ERROR "Unexpanded template variable in installed example")
endif()
string(FIND "${example}" "tnt_work_dir ${WORKDIR}" found)
if(found LESS 0)
  message(FATAL_ERROR "Incorrect installed work directory")
endif()
if(EXISTS "${stage}${CONFDIR}/tnt.ini")
  file(READ "${stage}${CONFDIR}/tnt.ini" previous)
  if(NOT previous STREQUAL "active configuration sentinel\n")
    message(FATAL_ERROR "Unexpected active configuration in staged installation")
  endif()
endif()
file(WRITE "${stage}${CONFDIR}/tnt.ini" "active configuration sentinel\n")
file(WRITE "${stage}${WORKDIR}/scrollback.journal" "history sentinel\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DESTDIR=${stage}"
  "${CMAKE_COMMAND}" --install "${BINARY_DIR}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Repeated staged installation failed")
endif()
file(READ "${stage}${CONFDIR}/tnt.ini" active)
file(READ "${stage}${WORKDIR}/scrollback.journal" history)
if(NOT active STREQUAL "active configuration sentinel\n" OR
   NOT history STREQUAL "history sentinel\n")
  message(FATAL_ERROR "Installation overwrote active configuration or history")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DESTDIR=${stage}"
  "${CMAKE_COMMAND}" -P "${BINARY_DIR}/Uninstall.cmake" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Staged uninstall failed")
endif()
foreach(path IN LISTS installed_paths links)
  if(IS_SYMLINK "${stage}${path}" OR
      (EXISTS "${stage}${path}" AND NOT IS_DIRECTORY "${stage}${path}"))
    message(FATAL_ERROR "Uninstall left an installed file: ${path}")
  endif()
endforeach()
file(READ "${stage}${CONFDIR}/tnt.ini" active)
file(READ "${stage}${WORKDIR}/scrollback.journal" history)
if(NOT active STREQUAL "active configuration sentinel\n" OR
   NOT history STREQUAL "history sentinel\n")
  message(FATAL_ERROR "Uninstall removed active configuration or history")
endif()
